rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function owner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }
    function placeIds() {
      return ['ajloun', 'jerash', 'ummqais', 'pella', 'ummjimal', 'salt', 'iraq', 'amman', 'citadel', 'kharana', 'madaba', 'deadsea', 'karak', 'dana', 'shobak', 'petra', 'rum', 'aqaba'];
    }
    function validIds(value) {
      return value is list && value.size() <= 18
        && value.toSet().hasOnly(placeIds())
        && value.toSet().size() == value.size();
    }
    function exactFields(value, names) {
      return value is map && value.keys().hasAll(names) && value.keys().hasOnly(names);
    }
    function validRange(value) {
      return value is list && value.size() == 2
        && value[0] is number && value[1] is number
        && value[0] >= 0 && value[1] <= 10000 && value[0] <= value[1];
    }
    function validRates(value) {
      return exactFields(value, ['foodPerPersonDay', 'roomPerNight', 'ownCarPerKm', 'driverPerDay', 'publicPerPersonDay'])
        && validRange(value.foodPerPersonDay)
        && validRange(value.roomPerNight)
        && validRange(value.ownCarPerKm)
        && validRange(value.driverPerDay)
        && validRange(value.publicPerPersonDay);
    }
    function validProfile(value) {
      return exactFields(value, ['days', 'people', 'budget', 'originId', 'interests', 'pace', 'nationality', 'transport', 'mustVisit', 'roundTrip', 'startDate', 'rates'])
        && value.days is int && value.days >= 1 && value.days <= 7
        && value.people is int && value.people >= 1 && value.people <= 12
        && (value.budget == null || value.budget is number && value.budget >= 0 && value.budget <= 1000000)
        && value.originId in placeIds()
        && value.interests is list && value.interests.size() >= 1 && value.interests.size() <= 6
        && value.interests.toSet().hasOnly(['nature', 'history', 'culture', 'adventure', 'relax', 'sea'])
        && value.interests.toSet().size() == value.interests.size()
        && value.pace in ['relaxed', 'balanced', 'active']
        && value.nationality in ['jordanian', 'foreign']
        && value.transport in ['car', 'driver', 'public']
        && validIds(value.mustVisit)
        && value.roundTrip is bool
        && (value.startDate == null || value.startDate is string && value.startDate.matches('^[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])$'))
        && validRates(value.rates);
    }
    function validPlan(value) {
      return exactFields(value, ['version', 'savedIds', 'tripProfile', 'tripStopIds', 'title', 'updatedAt'])
        && value.version is int && value.version == 1
        && validIds(value.savedIds) && validIds(value.tripStopIds)
        && (value.tripProfile == null && value.tripStopIds.size() == 0 || validProfile(value.tripProfile))
        && value.title is string && value.title.size() >= 1 && value.title.size() <= 160
        && value.title.matches('^[^\\x00-\\x1F\\x7F]+$')
        && value.title.matches('.*\\S.*')
        && value.updatedAt is timestamp && value.updatedAt == request.time;
    }


    match /users/{uid}/plans/current {
      allow get: if owner(uid);
      allow create, update: if owner(uid) && validPlan(request.resource.data);
      allow delete: if owner(uid);
    }
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
